#!/data/data/com.termux/files/usr/bin/python3
import os
import socket
import subprocess
import sys

cmd = " ".join(sys.argv[1:]).strip()
if not cmd:
    sys.exit(0)

# 1. Fast path: local uid=2000(shell) HybridBoxBridge daemon on 127.0.0.1:5558 (<10ms)
try:
    with socket.create_connection(("127.0.0.1", 5558), timeout=1.5) as s:
        s.settimeout(12.0)
        s.sendall((cmd + "\n").encode("utf-8"))
        chunks = []
        while True:
            data = s.recv(4096)
            if not data:
                break
            chunks.append(data)
        out = b"".join(chunks).decode("utf-8", errors="ignore")
        sys.stdout.write(out)
        sys.exit(0)
except Exception:
    pass

# 2. Fallback: local wireless ADB on 127.0.0.1:5555 (also uid=2000(shell), and restarts daemon 5558)
try:
    env = os.environ.copy()
    env["PATH"] = "/data/data/com.termux/files/usr/bin:/system/bin:/system/xbin"
    subprocess.run(
        ["/data/data/com.termux/files/usr/bin/adb", "connect", "127.0.0.1:5555"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2.0,
        env=env,
    )
    res = subprocess.run(
        [
            "/data/data/com.termux/files/usr/bin/adb",
            "-s",
            "127.0.0.1:5555",
            "shell",
            f"(pgrep -f 'HybridBoxBridge daemon' >/dev/null 2>&1 || nohup env CLASSPATH=/data/local/tmp/hybridbox_bridge.jar /system/bin/app_process / HybridBoxBridge daemon 5558 </dev/null >/data/local/tmp/hb_daemon.log 2>&1 &); {cmd}",
        ],
        capture_output=True,
        text=True,
        timeout=10.0,
        env=env,
    )
    if res.returncode == 0 or res.stdout:
        sys.stdout.write((res.stdout or "") + (res.stderr or ""))
        sys.exit(0)
except Exception:
    pass

# 3. Last resort: direct sh
res = subprocess.run(["/system/bin/sh", "-c", cmd], capture_output=True, text=True)
sys.stdout.write((res.stdout or "") + (res.stderr or ""))
